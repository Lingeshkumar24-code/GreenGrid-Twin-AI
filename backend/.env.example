# Copy to .env for local development. Never commit a real .env file.
DEMO_MODE=true
DATABASE_URL=
FRONTEND_ORIGIN=http://localhost:3000
AI_PROVIDER_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
ENVIRONMENT=development

# Computer vision: YOLO26n pretrained COCO person detector + Ultralytics ByteTrack.
# The official yolo26n.pt weights download on first use; a custom path must exist.
VISION_MODEL_WEIGHTS=yolo26n.pt
VISION_CONFIDENCE=0.35
VISION_MIN_QUALITY=0.25
VISION_SAMPLE_EVERY=5
VISION_MAX_UPLOAD_MB=50
VISION_MAX_VIDEO_SECONDS=120
VISION_EMPTY_CONFIRM_SECONDS=60
VISION_MAX_PIXELS=12000000
